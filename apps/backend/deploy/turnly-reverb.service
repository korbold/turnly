[Unit]
Description=Turnly Laravel Reverb WebSocket Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/var/www/turnly/apps/backend
ExecStart=/usr/bin/php artisan reverb:start --host=0.0.0.0 --port=8080

[Install]
WantedBy=multi-user.target
