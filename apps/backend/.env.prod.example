###############################################
# PROD .env template — copy to server as .env  #
# Path: /var/www/turnly/apps/backend/.env      #
# Perms: chown deploy:www-data, chmod 640      #
###############################################

APP_NAME=Turnly
APP_ENV=production
APP_KEY=                                  # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.goturnly.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_EC
APP_TIMEZONE=America/Guayaquil

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# DB — separar de dev. Crea user/db nuevos en MySQL prod.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=turnly_prod
DB_USERNAME=turnly_prod
DB_PASSWORD=                              # generar fuerte, no reusar dev

# Cache/queue/session en redis para prod (mejor perf que database driver)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.goturnly.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2                        # o s3 si usas AWS
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=                           # set password en redis.conf prod
REDIS_PORT=6379

# Mail — Resend con dominio prod verificado
MAIL_MAILER=resend
RESEND_KEY=                               # API key prod (no dev)
MAIL_FROM_ADDRESS="no-reply@goturnly.com"
MAIL_FROM_NAME="${APP_NAME}"

# R2 (Cloudflare) para uploads — bucket prod separado
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=turnly-prod
R2_ENDPOINT=
R2_URL=

# Frontend público — usado para magic-links / share URLs
FRONTEND_HOST=app.goturnly.com

# Google OAuth — client ID prod (registra dominio app.goturnly.com en consola)
GOOGLE_CLIENT_ID=

# Firebase — proyecto turnly-services-prod
FIREBASE_CREDENTIALS=storage/app/firebase/service-account-prod.json
FIREBASE_PROJECT_ID=turnly-services-prod

# Sanctum: 30 días
SANCTUM_EXPIRATION=43200
