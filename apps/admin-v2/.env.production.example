# Production env vars for the prod Vercel project (goturnly.com).
# Mirror these into the prod Vercel project once it's created. Do NOT
# apply them to the existing turnly-admin (dev) project — that one
# serves dev.goturnly.com and must keep using turnly-services (dev).
#
# Generate VAPID for prod web push manually:
#   Firebase Console → turnly-services-prod → Project Settings →
#   Cloud Messaging → Web configuration → Generate key pair.

NEXT_PUBLIC_API_URL=https://api.goturnly.com/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBm4u2pe3kjX-dTy2uI4sNNT5hF9Q7k4xk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=turnly-services-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=turnly-services-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=turnly-services-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=703054651952
NEXT_PUBLIC_FIREBASE_APP_ID=1:703054651952:web:8296e6b801bec72b67c3f5
NEXT_PUBLIC_FIREBASE_VAPID_KEY=__GENERATE_IN_FIREBASE_CONSOLE__
